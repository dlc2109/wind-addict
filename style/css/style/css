/*layouts*/
/*nav-bootstrap*/
header {
  display: flex;
  justify-content: space-between;
  position: sticky;
  top: 0;
  width: 100%;
  height: 100px;
  background: linear-gradient(109deg, rgba(0, 1, 13, 0.3) 12.87%, rgba(72, 184, 199, 0.3) 86.46%), #00010E;
  box-shadow: #b0b0b0 0px 0px 4px 0px;
}
header nav {
  padding: 0;
  background-color: rgb(2, 0, 23);
  height: auto;
}
header nav .container {
  height: 20px;
  height: 10%;
}
header nav img {
  display: inline-block;
  width: 140px;
}
header nav .navbar-toggler {
  border: none;
  box-shadow: none;
}
header nav .navbar-toggler:hover {
  background-color: transparent;
  border: none;
}
header nav .navbar-toggler .navbar-toggler-icon {
  background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 30"><path stroke="rgba(255, 255, 255,5)" stroke-width="2" d="M4 7h22M4 15h22M4 23h22"/></svg>');
}
header nav .navbar-toggler .navbar-toggler-icon:focus {
  box-shadow: none;
}
header nav .navbar-toggler .navbar-toggler-icon .nav-link {
  text-decoration: none;
  color: #F6F6F6;
  font-family: "Inter", serif;
  font-weight: 400;
  font-size: 1rem;
  transition: all 0.2s ease 0s;
}
header nav .navbar-toggler .navbar-toggler-icon .nav-link:hover {
  color: var(--color-button);
  border-bottom: var(--color-button) 1px solid;
  transition: 100ms;
}
header .buttom__nav {
  width: 158px;
  height: 44px;
  margin: 0;
  background-color: transparent;
  color: white;
  font-family: "inter";
  font-weight: 500;
  font-size: 16px;
  padding: 0 12px;
  border: solid 1px #f6f6f6;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.5s ease 0s;
}
header .buttom__nav:hover {
  color: var(--secundary-button);
  transition: all 0.5s ease 0s;
  border: solid 1px var(--secundary-button-hover);
}

@media screen and (max-width: 768px) {
  .buttom__nav {
    margin-left: 24px;
  }
  .navbar-toggler {
    box-shadow: none;
  }
  .navbar-toggler:hover {
    box-shadow: none;
  }
}
@media screen and (max-width: 480px) {
  header .buttom__nav {
    display: none;
  }
}
