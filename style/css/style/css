/*medias queries*/
/*base*/
* {
  margin: 0;
  box-sizing: border-box;
  padding: 0;
}

:root {
  background: var(--main-gradient, linear-gradient(168deg, rgba(0, 1, 13, 0.3) -62.4%, rgba(9, 40, 46, 0.3) 4.32%, rgba(72, 184, 199, 0.3) 166.08%), #00010E);
  background: var(--nav-gradient, linear-gradient(109deg, rgba(0, 1, 13, 0.3) 12.87%, rgba(72, 184, 199, 0.3) 86.46%), #00010E);
  --color-button: #00a6c4;
  --secundary-button: #FFC000;
  --secundary-button-hover: #FFD700;
  --color-headings: #f6f6f6;
  --color-text: #D9D9D9;
  --color-texblack: #00010E;
  --color-parrafo-card:#2a2a2a;
}

body {
  background-color: var(--main-gradient);
}

p {
  text-align: left;
}

h1 {
  font-family: "Poppins", serif;
  font-weight: 600;
  font-size: 24px;
  color: #fff;
}

h2 {
  font-family: "Poppins", serif;
  font-weight: 500;
  font-size: 20px;
  color: #FFC000;
}

h3 {
  font-family: "Poppins", serif;
  font-weight: 500;
  font-size: 16px;
  color: #fff;
}

p, article {
  font-family: "Poppins", serif;
  font-weight: 300;
  font-size: 16px;
  color: #f0f0f0;
}

@media screen and (max-width: 768px) {
  body h1 {
    font-size: 1.4rem;
  }
  body h2 {
    font-size: 1.2rem;
  }
  body h3 {
    font-size: 1rem;
  }
  body p {
    font-size: 1rem;
  }
  body article {
    font-size: 1rem;
  }
}
@media screen and (max-width: 480px) {
  body h1 {
    font-size: 1.2rem;
  }
  body h2 {
    font-size: 1rem;
  }
  body h3 {
    font-size: 0.9rem;
  }
  body p {
    font-size: 0.9rem;
  }
  body article {
    font-size: 0.9rem;
  }
}
/*componets*/
/*nav buttom*/
.buttom__nav {
  width: 158px;
  height: 44px;
  margin: 0;
  background-color: transparent;
  color: white;
  font-family: "inter";
  font-weight: 500;
  font-size: 16px;
  padding: 0 12px;
  border: solid 1px #f6f6f6;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.5s ease 0s;
}
.buttom__nav:hover {
  color: var(--secundary-button);
  transition: all 0.5s ease 0s;
  border: solid 1px var(--secundary-button-hover);
}

/*hero buttom*/
.hero__cta {
  width: 200px;
  height: 48px;
  background-color: #60f7ff;
  font-size: 18px;
  color: #000000;
  border: none;
  border-radius: 20px;
  font-weight: 500;
  box-shadow: 0 2px 10px 0px #010323;
  margin-top: 4px;
  margin-left: 10px;
  cursor: pointer;
}
.hero__cta:hover {
  background-color: var(--secundary-button);
  border-radius: 20px;
  box-shadow: 0 2px 10px 0px #010323;
  transition: all 0.2s ease-in-out 0s;
  color: #000000;
  font-weight: 500;
  box-shadow: none;
}

/*cards buttom*/
.card__cta {
  background-color: var(--secundary-button);
  border-radius: 100px;
  font-weight: 600;
  border: none;
  box-shadow: 0 2px 4px 0px #000647;
  padding: 8px 0;
  border-radius: 10px;
  transition: all 0.2s ease-in 0s;
}
.card__cta a {
  text-decoration: none;
  color: var(--color-texblack);
  font-family: "Poppins", serif;
  margin: auto;
}
.card__cta:hover {
  background-color: var(--secundary-button-hover);
  border-radius: 100px;
  font-size: 16px;
  color: #000000;
  color: var(--color-texblack);
  font-weight: 500;
  box-shadow: none;
  transition: all 0.2s ease-out 0s;
}

.--1 {
  display: inline-block;
  padding: 8px 24px;
}

.--2 {
  display: inline-block;
  padding: 8px 24px;
  margin-top: 1.2rem;
}

.--3 {
  display: inline-block;
  padding: 8px 24px;
}

/*main button*/
.principal__btn {
  display: inline-block;
  text-align: center;
  margin-top: 48px;
  margin-bottom: 48px;
  background-color: #FFC000;
  width: 200px;
  height: 40px;
  padding: 6px;
  border-radius: 10px;
  box-shadow: 0 0 5px 0 var(--color-headings);
  border: #F6F6F6 1px solid;
  transition: all 0.2s ease-in 0s;
}
.principal__btn:hover {
  background-color: #FFD700;
  transition: all 0.2s ease-in-out 0s;
}
.principal__btn a {
  text-decoration: none;
  color: var(--color-texblack);
  font-family: "Poppins", serif;
  font-size: 18px;
  font-weight: 600;
}

@media screen and (max-width: 768px) {
  .principal__btn {
    width: 140px;
    height: 38px;
    padding: 6px;
  }
  .nosotros__btn {
    width: 150px;
    height: 40px;
  }
  .nosotros__btn a {
    font-family: "Poppins", serif;
    font-size: 14px;
    font-weight: 500;
  }
}
@media screen and (max-width: 480px) {
  .hero__cta {
    width: 120px;
    height: 32px;
    background-color: #60f7ff;
    margin-left: 0;
    font-size: 14px;
  }
  .card__cta {
    width: 150px;
    height: 34px;
    font-size: 14px;
  }
}
